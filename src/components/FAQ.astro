---
import Reveal from "./Reveal.astro";

const faqs = [
  {
    q: "¿Qué tipos de asuntos atienden?",
    a: "Atendemos Derecho Civil, Familiar y Sucesorio, Laboral, Mercantil y Demandas y Juicios, tanto para personas físicas como morales.",
  },
  {
    q: "¿Cómo solicito una asesoría?",
    a: "Escríbenos por WhatsApp o envía el formulario de contacto y te responderemos a la brevedad.",
  },
  {
    q: "¿Atienden a personas físicas y morales?",
    a: "Sí, brindamos asesoría tanto a personas físicas como a morales (empresas).",
  },
  {
    q: "¿Cuál es el costo de la primera consulta?",
    a: "La primera consulta es el momento de conocer tu caso. Escríbenos y te informamos el costo según el tipo de asunto.",
  },
  {
    q: "¿Dónde están ubicados?",
    a: "Estamos en Plaza de Armas, Centro, Cuernavaca, Morelos. Escríbenos para coordinar una cita.",
  },
];
---

<section   class="bg-[#252523] py-20 sm:py-28" aria-label="Preguntas frecuentes">
  <div class="mx-auto max-w-6xl px-6">
    <div
      aria-hidden="true"
      class="mb-14 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"
    ></div>

    <Reveal>
      <div class="max-w-2xl">
        <h2 class="display text-3xl leading-tight text-ivory sm:text-4xl">
          Preguntas frecuentes
        </h2>
      </div>
    </Reveal>

    <!-- Accordion nativo: solo apariencia editorial, sin cajas -->
    <div class="mt-10">
      {faqs.map((faq, index) => (
        <Reveal delay={index * 60}>
          <details
            class="group border-b border-gold/10"
            id={`faq-${index}`}
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-left [&::-webkit-details-marker]:hidden"
            >
              <span class="display text-lg leading-snug text-ivory md:text-xl">
                {faq.q}
              </span>
              <span
                aria-hidden="true"
                class="shrink-0 text-2xl font-light leading-none text-gold transition-transform duration-300 group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <div
              class="pb-6 pr-8 leading-relaxed text-ivory/70 md:pr-20"
              set:html={faq.a}
            ></div>
          </details>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<style>
  .display {
    font-family: "Playfair Display", serif;
  }
</style>

<script>
  // Reflecting native `details` state into aria for enhanced accessibility.
  document.querySelectorAll("details[id^='faq-']").forEach((details) => {
    const summary = details.querySelector("summary") as HTMLElement;
    if (!summary) return;
    summary.setAttribute("aria-expanded", String(details.open));
    summary.setAttribute("aria-controls", `${details.id}-content`);
    const content = details.lastElementChild as HTMLElement;
    if (content) content.id = `${details.id}-content`;
    details.addEventListener("toggle", () => {
      summary.setAttribute("aria-expanded", String(details.open));
    });
  });
</script>