---
import Reveal from "./Reveal.astro";

const faqs = [
  {
    q: "¿Qué tipos de asuntos atienden?",
    a: "Atendemos Derecho Civil, Derecho Mercantil y Demandas. <span class=\"text-gold\">DATA_PENDING:</span> áreas adicionales.",
  },
  {
    q: "¿Cómo solicito una asesoría?",
    a: "Escríbenos por WhatsApp o envía el formulario de contacto y te responderemos a la brevedad.",
  },
  {
    q: "¿Atienden a personas y a empresas?",
    a: "Sí, brindamos asesoría tanto a personas físicas como a empresas.",
  },
  {
    q: "¿Cuál es el costo de la primera consulta?",
    a: "<span class=\"text-gold\">DATA_PENDING:</span> costo no confirmado.",
  },
  {
    q: "¿Dónde están ubicados?",
    a: "Ubicación por defecto: Zócalo de Cuernavaca (Plaza de Armas), Cuernavaca, Morelos. <span class=\"text-gold\">Provisional.</span>",
  },
];
---

<section class="bg-carbon py-20 sm:py-28" aria-label="Preguntas frecuentes">
  <div class="mx-auto max-w-3xl px-6">
    <Reveal>
      <h2 class="text-center text-3xl font-semibold text-ivory sm:text-4xl">
        Preguntas frecuentes
      </h2>
    </Reveal>

    <div class="mt-12 space-y-4">
      {faqs.map((faq, index) => (
        <Reveal delay={index * 60}>
          <details
            class="group rounded-xl border border-white/10 bg-white/5"
            id={`faq-${index}`}
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left font-semibold text-ivory [&::-webkit-details-marker]:hidden"
            >
              <span>{faq.q}</span>
              <span
                aria-hidden="true"
                class="shrink-0 text-gold transition-transform group-open:rotate-45"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </span>
            </summary>
            <div
              class="px-5 pb-5 text-ivory/80"
              set:html={faq.a}
            ></div>
          </details>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<script>
  // Reflecting native `details` state into aria for enhanced accessibility.
  document.querySelectorAll("details[id^='faq-']").forEach((details) => {
    const summary = details.querySelector("summary") as HTMLElement;
    if (!summary) return;
    summary.setAttribute("aria-expanded", String(details.open));
    summary.setAttribute("aria-controls", `${details.id}-content`);
    const content = details.lastElementChild as HTMLElement;
    if (content) content.id = `${details.id}-content`;
    details.addEventListener("toggle", () => {
      summary.setAttribute("aria-expanded", String(details.open));
    });
  });
</script>
