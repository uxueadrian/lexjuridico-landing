---
import Reveal from "./Reveal.astro";

const steps = [
  {
    number: "01",
    title: "Contáctanos",
    line: "Cuéntanos tu caso por WhatsApp o el formulario. Sin vueltas.",
  },
  {
    number: "02",
    title: "Evaluamos",
    line: "Analizamos tu situación, tus documentos y las vías reales de solución.",
  },
  {
    number: "03",
    title: "Te acompañamos",
    line: "Definimos la estrategia y te acompañamos hasta el resultado, con cercanía.",
  },
];
---

<section   class="bg-carbon py-20 sm:py-28" aria-label="Nuestro proceso">
  <div class="mx-auto max-w-6xl px-6">
    <div
      aria-hidden="true"
      class="mb-14 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"
    ></div>

    <Reveal>
      <div class="max-w-2xl">
        <h2 class="display text-3xl leading-tight text-ivory sm:text-4xl">
          Nuestro <span class="text-gold">proceso</span>
        </h2>
      </div>
    </Reveal>

    <!-- Pasos: fila editorial numerada, hairline conectora -->
    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-8">
      {steps.map((step, index) => (
        <Reveal delay={index * 80}>
          <div class="border-t border-gold/10 pt-8">
            <span class="display text-4xl italic text-gold/40 md:text-5xl">
              {step.number}
            </span>
            <h3 class="display mt-4 text-xl text-ivory md:text-2xl">
              {step.title}
            </h3>
            <p class="mt-2 max-w-md leading-relaxed text-ivory/70">
              {step.line}
            </p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<style>
  .display {
    font-family: "Playfair Display", serif;
  }
</style>