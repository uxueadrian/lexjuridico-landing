---
import { WHATSAPP_NUMBER, waLink } from "../lib/links";
import WhatsAppFloat from "./WhatsAppFloat.astro";

interface Props {
  title?: string;
  description?: string;
  children?: any;
}

const {
  title = "Abogado en Cuernavaca | Derecho Civil, Mercantil y Demandas — Lexjuridico Pineda & Asociados",
  description =
    "Abogado en Cuernavaca con asesoría jurídica cercana para personas físicas y morales. Especialistas en Derecho Civil, Derecho Mercantil y Demandas. Atención por WhatsApp.",
  children,
} = Astro.props;

// Domain real provide by the client. Canonical/OG/JSON-LD all derive from here.
const SITE_URL = "https://lexjuridicopinedaasociados.com.mx";

// Provisional Open Graph preview (hero image). Replace when a real brand/preview
// image is provided.
const OG_IMAGE = `${SITE_URL}/justicia.jpg`;

const legalServiceJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: "Lexjuridico Pineda & Asociados",
  telephone: "+52 777 240 2439",
  email: "lexjuridicopinedaasociados@gmail.com",
  url: SITE_URL,
  image: OG_IMAGE,
  priceRange: "$$",
  areaServed: [
    "Cuernavaca",
    "Cuernavaca, Morelos",
    "Morelos",
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: "Plaza de Armas, Centro", // provisional
    addressLocality: "Cuernavaca",
    addressRegion: "Morelos",
    addressCountry: "MX",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 18.9220008,
    longitude: -99.2298682,
  },
  sameAs: [waLink("Hola, quisiera contactar con Lexjuridico Pineda & Asociados.")],
});

const faqItems = [
  {
    q: "¿Qué tipos de asuntos atienden?",
    a: "Atendemos Derecho Civil, Derecho Mercantil y Demandas. DATA_PENDING: áreas adicionales.",
  },
  {
    q: "¿Cómo solicito una asesoría?",
    a: "Escríbenos por WhatsApp o envía el formulario de contacto y te responderemos a la brevedad.",
  },
  {
    q: "¿Atienden a personas físicas y morales?",
    a: "Sí, brindamos asesoría tanto a personas físicas como a morales (empresas).",
  },
  {
    q: "¿Cuál es el costo de la primera consulta?",
    a: "DATA_PENDING: costo no confirmado.",
  },
  {
    q: "¿Dónde están ubicados?",
    a: "Ubicación por defecto: Zócalo de Cuernavaca (Plaza de Armas), Cuernavaca, Morelos. Provisional.",
  },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL} />

    <!-- Tipografía del diseño de referencia: DM Sans (cuerpo) + Playfair Display (titulares). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph (Facebook / WhatsApp / LinkedIn previsualización) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lexjuridico Pineda & Asociados" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1656" />
    <meta property="og:image:height" content="2662" />
    <meta property="og:image:alt" content="Lexjuridico Pineda & Asociados — Abogados en Cuernavaca" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" set:html={legalServiceJsonLd} />
    <script type="application/ld+json" set:html={faqJsonLd} />
  </head>
  <body>
    <slot />
    <WhatsAppFloat />
  </body>
</html>
