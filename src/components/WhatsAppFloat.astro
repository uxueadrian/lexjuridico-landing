---
import { waLink } from "../lib/links";
---

<!-- Botón flotante de WhatsApp: siempre visible, animado, abajo a la derecha. -->
<a
  href={waLink("Hola, quisiera contactar con Lexjuridico Pineda & Asociados.")}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Contactar por WhatsApp"
>
  <span class="wa-float-label" aria-hidden="true">¿Te ayudamos?</span>
  <span class="wa-float-btn" aria-hidden="true">
    <span class="wa-float-pulse"></span>
    <span class="wa-float-pulse wa-float-pulse-delay"></span>
    <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.83 14.12c-.25.7-1.45 1.34-2 1.38-.51.04-.51.38-3.24-.68-2.73-1.06-4.44-3.79-4.58-3.96-.13-.18-1.09-1.46-1.09-2.78 0-1.32.69-1.97.94-2.24.25-.27.54-.34.72-.34.18 0 .36 0 .52.01.17.01.39-.06.61.47.22.54.76 1.88.83 2.01.07.13.11.28.02.46-.09.17-.13.27-.26.42-.13.15-.28.34-.4.45-.13.13-.27.28-.12.55.15.27.66 1.09 1.42 1.76.97.87 1.79 1.14 2.04 1.27.25.13.4.11.55-.06.14-.18.64-.75.81-1.01.17-.26.34-.22.57-.13.24.09 1.5.71 1.76.84.26.13.43.19.49.3.06.1.06.6-.19 1.12z" />
    </svg>
  </span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 9999;
    display: flex;
    align-items: center;
    text-decoration: none;
    animation: wa-float-rise 0.6s 0.4s ease both;
  }

  /* Botón circular con el verde oficial de WhatsApp. */
  .wa-float-btn {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    /* Recorta cualquier animación: nada sale del contorno. */
    overflow: hidden;
    box-shadow:
      0 10px 24px -6px rgba(37, 211, 102, 0.55),
      0 4px 10px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s ease;
  }

  .wa-float-btn svg {
    position: relative;
    z-index: 1;
    display: block;
  }

  .wa-float:hover .wa-float-btn {
    transform: scale(1.08);
  }

  .wa-float:active .wa-float-btn {
    transform: scale(0.95);
  }

  /* Anillo de pulso: crece desde el centro hasta el contorno exacto de la
     burbuja y se desvanece. Nunca sale del borde (overflow: hidden + escala máxima 1). */
  .wa-float-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.55);
    animation: wa-float-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }

  .wa-float-pulse-delay {
    animation-delay: 1.2s;
  }

  /* Label en hover (desktop): pill con mensaje. */
  .wa-float-label {
    position: relative;
    z-index: 1;
    margin-right: 12px;
    padding: 9px 16px;
    border-radius: 999px;
    background: #252523;
    border: 1px solid rgba(37, 211, 102, 0.45);
    color: #eee9de;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(8px);
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .wa-float:hover .wa-float-label {
    opacity: 1;
    transform: none;
  }

  @keyframes wa-float-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes wa-float-pulse {
    0% {
      transform: scale(0.55);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  @media (max-width: 760px) {
    .wa-float {
      right: 18px;
      bottom: 18px;
    }

    .wa-float-btn {
      width: 54px;
      height: 54px;
    }

    .wa-float-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float,
    .wa-float-pulse {
      animation: none;
    }
  }
</style>