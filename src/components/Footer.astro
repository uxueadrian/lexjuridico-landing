---
import { waLink } from "../lib/links";
import Reveal from "./Reveal.astro";
---

<footer class="bg-[#252523] py-12">
  <div class="mx-auto max-w-6xl px-6">
    <div
      aria-hidden="true"
      class="h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"
    ></div>

    <Reveal variant="blur">
      <div class="flex flex-col justify-between gap-10 py-14 md:flex-row md:items-start">
      <div class="max-w-sm">
        <a href="#inicio" aria-label="Lexjuridico Pineda y Asociados, inicio">
          <img
            src="/logo.png"
            alt="Lexjuridico Pineda y Asociados"
            width="300"
            height="300"
            class="h-14 w-auto object-contain"
          />
        </a>
        <p class="display mt-5 text-xl text-ivory">
          Lexjuridico Pineda &amp; Asociados
        </p>
        <p class="mt-2 text-sm leading-relaxed text-ivory/60">
          Asesoría jurídica profesional y cercana.
        </p>
      </div>

      <dl class="grid gap-0 md:w-80">
        <div class="grid grid-cols-[5.5rem_1fr] gap-4 border-b border-gold/10 py-4">
          <dt class="text-[11px] uppercase tracking-[0.22em] text-stone">WhatsApp</dt>
          <dd>
            <a
              href={waLink("Hola, quisiera contactar con el despacho.")}
              target="_blank"
              rel="noopener"
              class="text-sm text-ivory/80 transition-colors hover:text-gold"
            >
              +52 777 240 2439
            </a>
          </dd>
        </div>
        <div class="grid grid-cols-[5.5rem_1fr] gap-4 border-b border-gold/10 py-4">
          <dt class="text-[11px] uppercase tracking-[0.22em] text-stone">Correo</dt>
          <dd>
            <a
              href="mailto:lexjuridicopinedaasociados@gmail.com"
              class="break-all text-sm text-ivory/80 transition-colors hover:text-gold"
            >
              lexjuridicopinedaasociados@gmail.com
            </a>
          </dd>
        </div>
        <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-4">
          <dt class="text-[11px] uppercase tracking-[0.22em] text-stone">Dirección</dt>
          <dd class="text-sm text-ivory/80">
            Plaza de Armas, Centro, Cuernavaca, Morelos
          </dd>
        </div>
      </dl>
    </div>
  </Reveal>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-gold/10 py-6 text-sm text-ivory/50 md:flex-row">
      <p>© {new Date().getFullYear()} Lexjuridico Pineda &amp; Asociados</p>
      <div class="flex gap-8">
        <a href="#aviso" class="transition-colors hover:text-gold">
          Aviso de privacidad
        </a>
        <a href="#terminos" class="transition-colors hover:text-gold">
          Términos y condiciones
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .display {
    font-family: "Playfair Display", serif;
  }
</style>