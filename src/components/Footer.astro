---
import { waLink } from "../lib/links";
---

<footer class="border-t border-white/10 bg-carbon py-12">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row md:items-start">
      <div class="text-center md:text-left">
        <p class="text-lg font-semibold text-ivory">
          Lexjuridico Pineda &amp; Asociados
        </p>
        <p class="mt-2 text-sm text-stone">Asesoría jurídica profesional y cercana.</p>
      </div>

      <div class="text-center md:text-right">
        <a
          href={waLink("Hola, quisiera contactar con el despacho.")}
          target="_blank"
          rel="noopener"
          class="text-sm text-ivory/80 transition-colors hover:text-gold"
        >
          WhatsApp: +52 777 240 2439
        </a>
        <p class="mt-2 text-sm text-stone">
          <span class="text-gold">DATA_PENDING</span> · correo y dirección
        </p>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-sm text-stone md:flex-row">
      <p>© {new Date().getFullYear()} Lexjuridico Pineda &amp; Asociados</p>
      <div class="flex gap-6">
        <a href="#aviso" class="transition-colors hover:text-gold">
          Aviso de privacidad <span class="text-gold">(DATA_PENDING)</span>
        </a>
        <a href="#terminos" class="transition-colors hover:text-gold">
          Términos <span class="text-gold">(DATA_PENDING)</span>
        </a>
      </div>
    </div>
  </div>
</footer>
