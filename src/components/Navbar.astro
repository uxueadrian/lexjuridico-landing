---
import { waLink } from "../lib/links";

const navItems = [
  { href: "#inicio", label: "Inicio" },
  { href: "#servicios", label: "Servicios" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-carbon/90 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4"
    aria-label="Navegación principal"
  >
    <a href="#inicio" class="text-lg font-semibold tracking-tight text-ivory">
      Lexjuridico
      <span class="text-gold"> Pineda &amp; Asociados</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm text-ivory/80 transition-colors hover:text-gold"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={waLink("Hola, quisiera contactar con Lexjuridico Pineda & Asociados.")}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-gold px-4 py-2 text-sm font-semibold text-carbon transition-opacity hover:opacity-90"
      >
        Contactar por WhatsApp
      </a>
    </div>

    <!-- Mobile controls -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href={waLink("Hola, quisiera contactar con Lexjuridico Pineda & Asociados.")}
        target="_blank"
        rel="noopener"
        aria-label="Contactar por WhatsApp"
        class="flex items-center gap-2 rounded-md bg-gold px-3 py-2 text-sm font-semibold text-carbon"
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.83 14.12c-.25.7-1.45 1.34-2 1.38-.51.04-.51.38-3.24-.68-2.73-1.06-4.44-3.79-4.58-3.96-.13-.18-1.09-1.46-1.09-2.78 0-1.32.69-1.97.94-2.24.25-.27.54-.34.72-.34.18 0 .36 0 .52.01.17.01.39-.06.61.47.22.54.76 1.88.83 2.01.07.13.11.28.02.46-.09.17-.13.27-.26.42-.13.15-.28.34-.4.45-.13.13-.27.28-.12.55.15.27.66 1.09 1.42 1.76.97.87 1.79 1.14 2.04 1.27.25.13.4.11.55-.06.14-.18.64-.75.81-1.01.17-.26.34-.22.57-.13.24.09 1.5.71 1.76.84.26.13.43.19.49.3.06.1.06.6-.19 1.12z"/>
        </svg>
        WhatsApp
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        class="rounded-md p-2 text-ivory hover:text-gold"
      >
        <svg id="icon-open" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg id="icon-close" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-carbon md:hidden"
  >
    <ul class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-md px-3 py-3 text-sm text-ivory/80 transition-colors hover:bg-white/5 hover:text-gold"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement;
  const panel = document.getElementById("mobile-menu") as HTMLElement;
  const iconOpen = document.getElementById("icon-open") as HTMLElement;
  const iconClose = document.getElementById("icon-close") as HTMLElement;

  const setOpen = (open: boolean) => {
    panel.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!isOpen);
  });

  // Close on link activation.
  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  // Close on Escape, return focus to burger.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      const open = toggle.getAttribute("aria-expanded") === "true";
      if (open) {
        setOpen(false);
        toggle.focus();
      }
    }
  });

  // Close on outside click.
  document.addEventListener("click", (event) => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    const target = event.target as Node;
    if (
      open &&
      !toggle.contains(target) &&
      !panel.contains(target)
    ) {
      setOpen(false);
    }
  });
</script>
