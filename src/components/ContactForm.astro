---
---

<form id="consult-form" class="space-y-4" novalidate>
  <div class="flex flex-col gap-1.5">
    <label for="cf-name" class="text-sm font-medium text-ivory">Nombre</label>
    <input
      id="cf-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      placeholder="Tu nombre"
      class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory placeholder:text-stone focus:border-gold focus:outline-none"
    />
    <p id="cf-name-err" class="hidden text-sm text-red-400" role="alert"></p>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="cf-email" class="text-sm font-medium text-ivory">Correo electrónico</label>
    <input
      id="cf-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="tucorreo@ejemplo.com"
      class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory placeholder:text-stone focus:border-gold focus:outline-none"
    />
    <p id="cf-email-err" class="hidden text-sm text-red-400" role="alert"></p>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="cf-phone" class="text-sm font-medium text-ivory">Teléfono</label>
    <input
      id="cf-phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      placeholder="Tu teléfono"
      class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory placeholder:text-stone focus:border-gold focus:outline-none"
    />
  </div>

  <fieldset class="space-y-3 rounded-lg border border-white/10 bg-white/[0.03] p-4">
    <legend class="px-1 text-sm font-semibold text-gold">
      Agenda tu cita (opcional)
    </legend>

    <div class="flex flex-col gap-1.5">
      <label for="cf-date" class="text-sm font-medium text-ivory">Día preferente</label>
      <select
        id="cf-date"
        name="date"
        class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory focus:border-gold focus:outline-none"
      >
        <option value="">Selecciona un día</option>
        <option value="Lunes">Lunes</option>
        <option value="Martes">Martes</option>
        <option value="Miércoles">Miércoles</option>
        <option value="Jueves">Jueves</option>
        <option value="Viernes">Viernes</option>
        <option value="Sábado">Sábado (cita previa)</option>
      </select>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="cf-time" class="text-sm font-medium text-ivory">Hora preferente</label>
      <select
        id="cf-time"
        name="time"
        class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory focus:border-gold focus:outline-none"
      >
        <option value="">Selecciona una hora</option>
        <option value="09:00">09:00</option>
        <option value="10:00">10:00</option>
        <option value="11:00">11:00</option>
        <option value="12:00">12:00</option>
        <option value="13:00">13:00</option>
        <option value="14:00">14:00</option>
        <option value="16:00">16:00</option>
        <option value="17:00">17:00</option>
        <option value="18:00">18:00</option>
      </select>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="cf-mode" class="text-sm font-medium text-ivory">Modalidad</label>
      <select
        id="cf-mode"
        name="mode"
        class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory focus:border-gold focus:outline-none"
      >
        <option value="">Selecciona la modalidad</option>
        <option value="Presencial">Presencial</option>
        <option value="Videollamada">Videollamada</option>
        <option value="Telefónica">Telefónica</option>
      </select>
    </div>
  </fieldset>

  <p class="rounded-md border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-ivory/70">
    <span class="font-semibold text-gold">Disponibilidad:</span>{" "}
    Lunes a viernes de 9:00 a 18:00 h. <span class="text-stone">(Horarios provisionales — DATA_PENDING: confirmar con el despacho)</span>
  </p>


  <div class="flex flex-col gap-1.5">
    <label for="cf-message" class="text-sm font-medium text-ivory">Mensaje</label>
    <textarea
      id="cf-message"
      name="message"
      rows="4"
      required
      placeholder="Cuéntanos tu caso"
      class="rounded-md border border-white/20 bg-carbon px-4 py-3 text-ivory placeholder:text-stone focus:border-gold focus:outline-none"
    ></textarea>
    <p id="cf-message-err" class="hidden text-sm text-red-400" role="alert"></p>
  </div>

  <button
    type="submit"
    class="inline-flex w-full items-center justify-center rounded-md bg-gold px-6 py-3 font-semibold text-carbon transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
  >
    Enviar consulta
  </button>

  <p id="cf-status" class="hidden text-sm" role="status"></p>
  <p id="cf-fallback" class="hidden text-sm"></p>
</form>

<script>
  const form = document.getElementById("consult-form") as HTMLFormElement;
  const statusEl = document.getElementById("cf-status") as HTMLElement;
  const fallbackEl = document.getElementById("cf-fallback") as HTMLElement;

  // WhatsApp fallback deep link (matches links.ts: wa.me + URL-encoded prefill).
  const whatsappUrl = (message: string) =>
    `https://wa.me/527772402439?text=${encodeURIComponent(message)}`;

  const showStatus = (message: string, kind: "ok" | "error") => {
    statusEl.textContent = message;
    statusEl.className = `text-sm ${kind === "ok" ? "text-emerald-400" : "text-red-400"}`;
    statusEl.removeAttribute("hidden");
  };

  const showFieldError = (id: string, message: string) => {
    const err = document.getElementById(id) as HTMLElement;
    err.textContent = message;
    err.classList.remove("hidden");
  };

  const clearFieldError = (id: string) => {
    const err = document.getElementById(id) as HTMLElement;
    err.textContent = "";
    err.classList.add("hidden");
  };

  // Read runtime keys. When any is missing, the form fails closed.
  const publicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY as string | undefined;
  const serviceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID as string | undefined;
  const templateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID as string | undefined;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    fallbackEl.classList.add("hidden");
    fallbackEl.textContent = "";
    statusEl.classList.add("hidden");
    clearFieldError("cf-name-err");
    clearFieldError("cf-email-err");
    clearFieldError("cf-message-err");

    const name = (document.getElementById("cf-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("cf-email") as HTMLInputElement).value.trim();
    const message = (document.getElementById("cf-message") as HTMLTextAreaElement).value.trim();
    const date = (document.getElementById("cf-date") as HTMLSelectElement).value;
    const time = (document.getElementById("cf-time") as HTMLSelectElement).value;
    const mode = (document.getElementById("cf-mode") as HTMLSelectElement).value;

    let valid = true;
    if (!name) {
      showFieldError("cf-name-err", "Por favor escribe tu nombre.");
      valid = false;
    }
    if (!email) {
      showFieldError("cf-email-err", "Por favor escribe tu correo electrónico.");
      valid = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showFieldError("cf-email-err", "Por favor escribe un correo válido.");
      valid = false;
    }
    if (!message) {
      showFieldError("cf-message-err", "Por favor escribe tu mensaje.");
      valid = false;
    }
    if (!valid) return;

    // Missing keys -> graceful Spanish failure with WhatsApp fallback.
    if (!publicKey || !serviceId || !templateId) {
      fallbackEl.innerHTML = `El formulario no está disponible en este momento. <a href="${whatsappUrl("Hola, quisiera enviar una consulta jurídica.")}" target="_blank" rel="noopener" class="text-gold underline">Escríbenos por WhatsApp.</a>`;
      fallbackEl.classList.remove("hidden");
      fallbackEl.className = "text-sm text-ivory/80";
      return;
    }

    const { init, sendForm } = await import("@emailjs/browser");
    init({ publicKey });

    try {
      await sendForm(serviceId, templateId, form, {
        name,
        email,
        message,
        date,
        time,
        mode,
      });
      showStatus("Mensaje enviado. Te contactaremos pronto.", "ok");
      form.reset();
    } catch (error) {
      console.error(error);
      fallbackEl.innerHTML = `El formulario no está disponible en este momento. <a href="${whatsappUrl("Hola, quisiera enviar una consulta jurídica.")}" target="_blank" rel="noopener" class="text-gold underline">Escríbenos por WhatsApp.</a>`;
      fallbackEl.classList.remove("hidden");
      fallbackEl.className = "text-sm text-ivory/80";
    }
  });
</script>

