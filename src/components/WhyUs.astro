---
import Reveal from "./Reveal.astro";
import { Award, HeartHandshake, ShieldCheck, Target } from "@lucide/astro";

const items = [
  {
    icon: Award,
    number: "01",
    title: "Experiencia jurídica",
    line: "Conocemos a fondo cada materia que atendemos y anticipamos lo que viene.",
  },
  {
    icon: HeartHandshake,
    number: "02",
    title: "Atención cercana",
    line: "Te escuchamos y te explicamos cada paso con claridad, sin tecnicismos innecesarios.",
  },
  {
    icon: ShieldCheck,
    number: "03",
    title: "Confidencialidad",
    line: "Tu información está protegida en todo momento. Lo que nos cuentas, se queda con nosotros.",
  },
  {
    icon: Target,
    number: "04",
    title: "Compromiso con resultados",
    line: "Trabajamos con dedicación por tu mejor solución legal, con estrategia y seguimiento.",
  },
];
---

<section   class="bg-carbon py-20 sm:py-28" aria-label="¿Por qué elegirnos?">
  <div class="mx-auto max-w-6xl px-6">
    <div
      aria-hidden="true"
      class="mb-14 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"
    ></div>

    <Reveal>
      <div class="max-w-2xl">
        <p class="flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.28em] text-gold">
          <span aria-hidden="true" class="h-px w-8 bg-gold/70"></span>
          Nuestras ventajas
        </p>
        <h2 class="display mt-4 text-3xl leading-tight text-ivory sm:text-4xl">
          ¿Por qué <span class="text-gold">elegirnos</span>?
        </h2>
      </div>
    </Reveal>

    <!-- Ventajas: filas editoriales a dos columnas, sin cards -->
    <div class="mt-14 grid gap-x-8 gap-y-0 md:grid-cols-2">
      {items.map((item, index) => {
        const Icon = item.icon;
        return (
          <Reveal delay={index * 80}>
            <div class="flex gap-5 border-b border-gold/10 py-8">
              <span class="display text-2xl italic text-gold/40">
                {item.number}
              </span>
              <div>
                <div class="flex items-center gap-2.5">
                  <span aria-hidden="true" class="text-gold">
                    <Icon width="16" height="16" />
                  </span>
                  <h3 class="display text-xl text-ivory">{item.title}</h3>
                </div>
                <p class="mt-2 max-w-md leading-relaxed text-ivory/70">
                  {item.line}
                </p>
              </div>
            </div>
          </Reveal>
        );
      })}
    </div>
  </div>
</section>

<style>
  .display {
    font-family: "Playfair Display", serif;
  }
</style>