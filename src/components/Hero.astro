---
import { waLink } from "../lib/links";
import Reveal from "./Reveal.astro";
---

<section
  id="inicio"
  class="relative flex min-h-[88vh] items-center overflow-hidden bg-carbon"
  aria-label="Presentación"
>
  <!-- Background: Statue of Lady Justice. Decorative, not semantic. -->
  <div
    aria-hidden="true"
    class="absolute inset-0"
    style="background-image: url('/justicia.jpg'); background-size: cover; background-position: 70% 20%;"
  ></div>

  <!-- Legibility overlay: carbon fade, stronger on the text side. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-r from-carbon via-carbon/80 to-carbon/30"
  ></div>
  <!-- Contact dark fade from below into next section. -->
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-carbon to-transparent"
  ></div>

  <div class="relative mx-auto w-full max-w-6xl px-6 py-24 sm:py-32">
    <div class="max-w-2xl">
      <Reveal>
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-gold">
          Lexjuridico Pineda &amp; Asociados
        </p>
      </Reveal>

      <Reveal delay={80}>
        <h1 class="mt-5 text-4xl font-semibold leading-tight text-ivory sm:text-5xl md:text-6xl">
          Defendemos tus derechos con experiencia y compromiso
        </h1>
      </Reveal>

      <Reveal delay={160}>
        <p class="mt-6 max-w-xl text-lg text-ivory/85">
          Asesoría jurídica profesional y cercana para personas y empresas
        </p>
      </Reveal>

      <Reveal delay={240}>
        <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row">
          <a
            href={waLink("Hola, quisiera solicitar una asesoría jurídica.")}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center rounded-md bg-gold px-7 py-3.5 text-base font-semibold text-carbon transition-opacity hover:opacity-90"
          >
            Contactar por WhatsApp
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center rounded-md border border-ivory/25 px-7 py-3.5 text-base font-semibold text-ivory transition-colors hover:border-gold hover:text-gold"
          >
            Conoce nuestros servicios
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>
