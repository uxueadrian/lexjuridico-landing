---
import { waLink } from "../lib/links";
import ContactForm from "./ContactForm.astro";
import Reveal from "./Reveal.astro";
---

<section
  id="contacto"
  class="scroll-mt-16 bg-carbon py-20 sm:py-28"
  aria-label="Contacto"
>
  <div class="mx-auto max-w-6xl px-6">
    <div
      aria-hidden="true"
      class="mb-14 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"
    ></div>

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Columna editorial: datos de contacto -->
      <Reveal>
        <div>
          <p class="flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.28em] text-gold">
            <span aria-hidden="true" class="h-px w-8 bg-gold/70"></span>
            Contacto
          </p>
          <h2 class="display mt-4 text-3xl leading-tight text-ivory sm:text-4xl">
            Hablemos de <span class="text-gold">tu caso</span>
          </h2>
          <p class="mt-4 max-w-md leading-relaxed text-ivory/70">
            Escríbenos por WhatsApp, marca o envía tu consulta y te respondemos a
            la brevedad.
          </p>

          <a
            href={waLink("Hola, quisiera enviar un mensaje a Lexjuridico.")}
            target="_blank"
            rel="noopener"
            class="mt-9 inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 text-sm font-bold uppercase tracking-wide text-carbon transition hover:bg-gold/90 hover:shadow-[0_0_28px_rgba(184,149,62,0.35)]"
          >
            Enviar mensaje por WhatsApp
            <span aria-hidden="true">→</span>
          </a>

          <dl class="mt-12 border-t border-gold/10">
            <div class="grid gap-1 border-b border-gold/10 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <dt class="text-[11px] uppercase tracking-[0.22em] text-stone">
                Teléfono
              </dt>
              <dd>
                <a
                  href="tel:+527772402439"
                  class="text-ivory transition-colors hover:text-gold"
                >
                  +52 777 240 2439
                </a>
              </dd>
            </div>
            <div class="grid gap-1 border-b border-gold/10 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <dt class="text-[11px] uppercase tracking-[0.22em] text-stone">
                Correo
              </dt>
              <dd>
                <a
                  href="mailto:lexjuridicopinedaasociados@gmail.com"
                  class="break-all text-ivory transition-colors hover:text-gold"
                >
                  lexjuridicopinedaasociados@gmail.com
                </a>
              </dd>
            </div>
            <div class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <dt class="text-[11px] uppercase tracking-[0.22em] text-stone">
                Dirección
              </dt>
              <dd class="text-ivory">Plaza de Armas, Centro, Cuernavaca, Morelos</dd>
            </div>
          </dl>
        </div>
      </Reveal>

      <!-- Form column -->
      <Reveal delay={100}>
        <div>
          <h3 class="display text-2xl leading-snug text-ivory">Envía tu consulta</h3>
          <div class="mt-8">
            <ContactForm />
          </div>
        </div>
      </Reveal>
    </div>

    <!-- Mapa. OpenStreetMap embed: carga sin API key, sin cookies de terceros
         y no es bloqueado por adblockers (a diferencia del iframe de Google Maps,
         que en navegadores con bloqueo de terceros queda en blanco).
         Markers: Zócalo de Cuernavaca (Plaza de Armas). -->
    <div class="mt-20">
      <iframe
        title="Mapa de ubicación — Zócalo de Cuernavaca"
        src="https://www.openstreetmap.org/export/embed.html?bbox=-99.2390%2C18.9165%2C-99.2185%2C18.9275&layer=mapnik&marker=18.9220%2C-99.2287"
        width="100%"
        height="420"
        style="border: 0; display: block; background: var(--color-carbon);"
        loading="lazy"
        class="rounded-xl border border-white/10"
      ></iframe>
      <p class="mt-4 text-center text-sm">
        <span class="text-ivory">Zócalo de Cuernavaca (Plaza de Armas)</span>
        <span aria-hidden="true" class="mx-2 text-gold/60">·</span>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Z%C3%B3calo%20de%20Cuernavaca"
          target="_blank"
          rel="noopener"
          class="text-gold underline-offset-4 transition-colors hover:text-ivory"
        >
          Cómo llegar
        </a>
      </p>
    </div>

    <!-- Conversión consolidada: la asesoría vive dentro de Contacto.
         (Ya no existe una sección CTA separada — todo en contacto.) -->
    <Reveal delay={120}>
      <div class="mt-24 text-center">
        <div
          aria-hidden="true"
          class="mx-auto mb-10 h-px max-w-xl bg-gradient-to-r from-transparent via-gold/60 to-transparent"
        ></div>
        <h3 class="display text-2xl leading-tight text-ivory sm:text-3xl">
          ¿Necesitas asesoría legal?
        </h3>
        <p class="mt-3 text-ivory/70">
          Cuéntanos tu caso y recibirás una respuesta rápida.
        </p>
        <a
          href={waLink("Hola, necesito asesoría legal.")}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 text-sm font-bold uppercase tracking-wide text-carbon transition hover:bg-gold/90 hover:shadow-[0_0_28px_rgba(184,149,62,0.35)]"
        >
          Solicitar asesoría
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .display {
    font-family: "Playfair Display", serif;
  }
</style>