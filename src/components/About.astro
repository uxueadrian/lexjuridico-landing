---
import { waLink } from "../lib/links";
import Reveal from "./Reveal.astro";
---

<section id="nosotros" class="scroll-mt-16 bg-carbon py-20 sm:py-28" aria-label="Sobre nosotros">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <Reveal>
      <h2 class="text-3xl font-semibold text-ivory sm:text-4xl">
        Sobre nosotros
      </h2>
    </Reveal>

    <Reveal delay={80}>
      <p class="mt-6 text-lg leading-relaxed text-ivory/80">
        En Lexjuridico Pineda &amp; Asociados acompañamos a personas y empresas
        con una visión cercana y profesional del derecho. Nos dedicamos con
        seriedad y compromiso a proteger tus intereses y a brindarte la certeza
        que necesitas en cada decisión legal.
      </p>
    </Reveal>

    <!-- DATA_PENDING: photos and biography swap in here (no structural change) -->
    <Reveal delay={140}>
      <p class="mt-6 text-sm text-stone">
        DATA_PENDING: fotos y semblanza
      </p>
    </Reveal>

    <Reveal delay={200}>
      <a
        href={waLink("Hola, me gustaría hablar con un abogado.")}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-carbon transition-opacity hover:opacity-90"
      >
        Hablar con un abogado
      </a>
    </Reveal>
  </div>
</section>
