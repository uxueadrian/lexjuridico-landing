---
import { Scale, Users, Briefcase, Banknote, FileText } from "@lucide/astro";
import { waLink } from "../lib/links";
import Reveal from "./Reveal.astro";

const services = [
  {
    icon: Scale,
    num: "01",
    title: "Derecho Civil",
    desc: "Contratos, propiedad, obligaciones y toda situación que requiere respaldo legal privado. Protegemos lo que es tuyo.",
  },
  {
    icon: Users,
    num: "02",
    title: "Derecho Familiar y Sucesorio",
    desc: "Herencias, testamentos y asuntos familiares. Tu familia merece claridad y respeto en cada paso.",
  },
  {
    icon: Briefcase,
    num: "03",
    title: "Derecho Laboral",
    desc: "Despidos injustificados, liquidaciones e indemnizaciones. Conocemos tus derechos y hacemos que se cumplan.",
  },
  {
    icon: Banknote,
    num: "04",
    title: "Derecho Mercantil",
    desc: "Sociedades, contratos comerciales y cobro de deudas. Tu negocio merece solidez jurídica.",
  },
  {
    icon: FileText,
    num: "05",
    title: "Demandas y Juicios",
    desc: "Representación legal en procedimientos civiles y mercantiles. Te acompañamos de principio a fin.",
  },
];
---

<section
  id="servicios"
  class="scroll-mt-16 relative overflow-hidden bg-[#252523] py-28 sm:py-36"
  aria-label="Áreas jurídicas"
>
  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <Reveal>
      <div class="text-center">
        <div class="section-divider mb-8" aria-hidden="true"></div>
        <p class="text-xs font-semibold uppercase tracking-[0.32em] text-gold/80">
          Áreas jurídicas
        </p>
        <h2
          class="mt-4 text-4xl font-medium text-ivory sm:text-5xl"
          style="font-family: 'Playfair Display', serif"
        >
          Cada materia con <span class="italic text-gold">una estrategia clara.</span>
        </h2>
      </div>
    </Reveal>

    <div class="mt-24 space-y-20">
      {services.map((s, i) => {
        const Icon = s.icon;
        const isEven = i % 2 === 0;
        return (
          <Reveal
          variant={isEven ? "left" : "right"}
          delay={i * 120}
        >
            <div class={`group flex flex-col items-start gap-8 sm:flex-row sm:items-center sm:gap-16 ${isEven ? '' : 'sm:flex-row-reverse'}`}>
              <!-- Number + Icon -->
              <div class="flex shrink-0 flex-col items-center gap-4">
                <span
                  class="text-7xl font-light italic text-gold/20 transition-all duration-700 group-hover:text-gold/60 sm:text-8xl"
                  style="font-family: 'Playfair Display', serif"
                >
                  {s.num}
                </span>
                <div class="flex h-16 w-16 items-center justify-center rounded-full border border-gold/15 text-gold/50 transition-all duration-700 group-hover:border-gold/40 group-hover:text-gold">
                  <Icon width="28" height="28" />
                </div>
              </div>

              <!-- Content -->
              <div class="flex-1">
                <h3
                  class="text-3xl font-medium text-ivory transition-colors duration-500 group-hover:text-ivory sm:text-4xl"
                  style="font-family: 'Playfair Display', serif"
                >
                  {s.title}
                </h3>
                <p class="mt-4 max-w-md text-base leading-relaxed text-stone">
                  {s.desc}
                </p>
                <a
                  href={waLink(`Hola, quisiera una asesoría sobre ${s.title}.`)}
                  target="_blank"
                  rel="noopener"
                  class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold/70 transition-all duration-500 hover:text-gold hover:gap-3"
                >
                  Solicitar asesoría
                  <svg
                    aria-hidden="true"
                    class="transition-transform duration-300 group-hover:translate-x-1"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

            {/* Divider — not after last item */}
            {i < services.length - 1 && (
              <div
                class="mt-20 h-px w-full bg-gradient-to-r from-transparent via-gold/10 to-transparent"
                aria-hidden="true"
              />
            )}
          </Reveal>
        );
      })}
    </div>
  </div>
</section>