---
import { waLink } from "../lib/links";
import Reveal from "./Reveal.astro";
import { Scale, Briefcase, FileText } from "@lucide/astro";

const services = [
  {
    icon: Scale,
    title: "Derecho Civil",
    description: "Contratos, sucesiones, propiedad y asuntos familiares.",
    accent: "Contratos · Sucesiones · Propiedad · Familia",
  },
  {
    icon: Briefcase,
    title: "Derecho Mercantil",
    description: "Sociedades, contratos comerciales y cumplimiento legal para personas morales (empresas).",
    accent: "Sociedades · Comercio · Cumplimiento",
  },
  {
    icon: FileText,
    title: "Demandas",
    description: "Representación legal en demandas civiles y mercantiles.",
    accent: "Civiles · Mercantiles · Representación",
  },
];
---

<section id="servicios" class="scroll-mt-16 bg-carbon py-20 sm:py-28" aria-label="Áreas jurídicas">
  <div class="mx-auto max-w-6xl px-6">
    <Reveal>
      <h2 class="text-center text-3xl font-semibold text-ivory sm:text-4xl">
        Áreas jurídicas
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-ivory/70">
        Acompañamos personas físicas y morales con solidez jurídica.
      </p>
    </Reveal>

    <!-- Carousel on small screens (scroll-snap), static grid on md+ -->
    <ul
      class="mt-14 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 scrollbar-hide md:grid md:grid-cols-3 md:overflow-visible md:pb-0"
    >
      {services.map((service) => {
        const Icon = service.icon;
        return (
          <li
            class="group relative flex w-[85%] shrink-0 snap-center flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.07] to-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-gold/40 md:w-auto md:shrink md:snap-none"
          >
            <!-- Top gold hairline accent -->
            <div
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"
            ></div>

            <Reveal>
              <div
                class="flex h-14 w-14 items-center justify-center rounded-xl bg-gold/15 text-gold ring-1 ring-gold/30 transition-colors group-hover:bg-gold group-hover:text-carbon"
              >
                <Icon width="26" height="26" />
              </div>

              <h3 class="mt-6 text-2xl font-semibold text-ivory">
                {service.title}
              </h3>
              <p class="mt-3 leading-relaxed text-ivory/75">
                {service.description}
              </p>
              <p class="mt-4 text-sm uppercase tracking-wide text-stone">
                {service.accent}
              </p>

              <a
                href={waLink(`Hola, quisiera una asesoría sobre ${service.title}.`)}
                target="_blank"
                rel="noopener"
                class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-gold transition-colors hover:text-ivory"
              >
                Solicitar asesoría
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="transition-transform group-hover:translate-x-1"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </Reveal>
          </li>
        );
      })}
    </ul>

    <!-- Extra practice areas: DATA_PENDING slot (no structural change on swap-in) -->
    <Reveal delay={120}>
      <p class="mt-8 text-center text-sm text-stone">
        DATA_PENDING: áreas adicionales
      </p>
    </Reveal>
  </div>
</section>
